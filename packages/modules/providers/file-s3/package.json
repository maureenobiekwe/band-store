{
  "name": "@band-store/file-s3",
  "version": "2.22.4",
  "description": "S3 protocol file storage for band-store. Supports any S3-compatible storage provider",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medusajs/medusa.git",
    "directory": "packages/modules/providers/file-s3"
  },
  "bugs": {
    "url": "https://github.com/medusajs/medusa/issues"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "author": "Medusa",
  "license": "MIT",
  "scripts": {
    "test": "../../../../node_modules/.bin/jest --passWithNoTests src",
    "test:integration": "../../../../node_modules/.bin/jest --passWithNoTests --forceExit --testPathPatterns=\"integration-tests/__tests__/[^/]*\\.spec\\.ts\"",
    "build": "yarn run -T rimraf dist && yarn run -T tsc --build ./tsconfig.json",
    "watch": "yarn run -T tsc --watch"
  },
  "devDependencies": {
    "@band-store/framework": "2.22.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "ulid": "^3.0.2"
  },
  "peerDependencies": {
    "@band-store/framework": "2.22.4"
  },
  "keywords": [
    "band-store-plugin",
    "band-store-plugin-s3"
  ]
}
