{
  "name": "@band-store/analytics",
  "version": "2.22.4",
  "description": "Band Store Analytics module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "AGENTS.md",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/band-storejs/band-store.git",
    "directory": "packages/modules/analytics"
  },
  "bugs": {
    "url": "https://github.com/band-storejs/band-store/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "band-store",
  "license": "MIT",
  "scripts": {
    "watch": "yarn run -T tsc --build --watch",
    "watch:test": "yarn run -T tsc --build tsconfig.spec.json --watch",
    "resolve:aliases": "yarn run -T tsc --showConfig -p tsconfig.json > tsconfig.resolved.json && yarn run -T tsc-alias -p tsconfig.resolved.json && yarn run -T rimraf tsconfig.resolved.json",
    "build": "yarn run -T rimraf dist && yarn run -T tsc --build && npm run resolve:aliases",
    "test": "../../../node_modules/.bin/jest --passWithNoTests --bail --forceExit --testPathPatterns=src",
    "test:integration": "../../../node_modules/.bin/jest --passWithNoTests --forceExit --testPathPatterns=\"integration-tests/__tests__/.*\\.ts\""
  },
  "devDependencies": {
    "@band-store/framework": "2.22.4",
    "@band-store/test-utils": "2.22.4"
  },
  "peerDependencies": {
    "@band-store/framework": "2.22.4"
  }
}
