{
  "name": "@band-store/workflow-engine-inmemory",
  "version": "2.22.4",
  "description": "Band Store Workflow Orchestrator module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "AGENTS.md",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/band-storejs/band-store.git",
    "directory": "packages/modules/workflow-engine-inmemory"
  },
  "bugs": {
    "url": "https://github.com/band-storejs/band-store/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "band-store",
  "license": "MIT",
  "scripts": {
    "watch": "yarn run -T tsc --build --watch",
    "watch:test": "yarn run -T tsc --build tsconfig.spec.json --watch",
    "resolve:aliases": "yarn run -T tsc --showConfig -p tsconfig.json > tsconfig.resolved.json && yarn run -T tsc-alias -p tsconfig.resolved.json && yarn run -T rimraf tsconfig.resolved.json",
    "build": "yarn run -T rimraf dist && yarn run -T tsc --build && npm run resolve:aliases",
    "test": "../../../node_modules/.bin/jest --passWithNoTests --bail --forceExit --testPathPatterns=src",
    "test:integration": "../../../node_modules/.bin/jest --passWithNoTests --forceExit --testPathPatterns=\"integration-tests/__tests__/index\\.spec\\.ts\" && ../../../node_modules/.bin/jest --passWithNoTests --forceExit --testPathPatterns=\"integration-tests/__tests__/race\\.spec\\.ts\" && ../../../node_modules/.bin/jest --passWithNoTests --forceExit --testPathPatterns=\"integration-tests/__tests__/subscribe\\.spec\\.ts\" && ../../../node_modules/.bin/jest --passWithNoTests --forceExit --testPathPatterns=\"integration-tests/__tests__/retry-interval\\.spec\\.ts\"",
    "migration:initial": "MIKRO_ORM_CLI_CONFIG=./mikro-orm.config.dev.ts MIKRO_ORM_ALLOW_GLOBAL_CLI=true band-store-mikro-orm migration:create --initial",
    "migration:create": "MIKRO_ORM_CLI_CONFIG=./mikro-orm.config.dev.ts MIKRO_ORM_ALLOW_GLOBAL_CLI=true band-store-mikro-orm migration:create",
    "migration:up": "MIKRO_ORM_CLI_CONFIG=./mikro-orm.config.dev.ts MIKRO_ORM_ALLOW_GLOBAL_CLI=true band-store-mikro-orm migration:up",
    "orm:cache:clear": "MIKRO_ORM_CLI_CONFIG=./mikro-orm.config.dev.ts MIKRO_ORM_ALLOW_GLOBAL_CLI=true band-store-mikro-orm cache:clear"
  },
  "devDependencies": {
    "@band-store/framework": "2.22.4",
    "@band-store/test-utils": "2.22.4"
  },
  "dependencies": {
    "cron-parser": "^5.10.2",
    "ulid": "^3.0.2"
  },
  "peerDependencies": {
    "@band-store/framework": "2.22.4"
  }
}
