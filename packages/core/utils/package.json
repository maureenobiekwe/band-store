{
  "name": "@band-store/utils",
  "version": "2.22.4",
  "description": "Band Store utilities functions shared by Band Store core and Modules",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medusajs/medusa.git",
    "directory": "packages/core/utils"
  },
  "bugs": {
    "url": "https://github.com/medusajs/medusa/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "author": "Medusa",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@band-store/types": "2.22.4",
    "express": "^4.21.0"
  },
  "dependencies": {
    "@band-store/deps": "2.22.4",
    "@graphql-codegen/core": "^6.2.2",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-tools/merge": "^10.0.6",
    "@graphql-tools/schema": "^11.0.6",
    "@types/pluralize": "^0.0.33",
    "bignumber.js": "^11.1.5",
    "dotenv": "^18.0.9",
    "dotenv-expand": "^13.0.0",
    "graphql": "^17.0.2",
    "jsonwebtoken": "^9.0.2",
    "pg-connection-string": "^2.14.1",
    "pluralize": "^8.0.0",
    "ulid": "^3.0.2"
  },
  "peerDependencies": {
    "express": "^4.21.0"
  },
  "scripts": {
    "build": "yarn run -T rimraf dist && yarn run -T tsc --build",
    "watch": "yarn run -T tsc --build --watch",
    "test": "../../../node_modules/.bin/jest --silent=false --bail --forceExit --testPathIgnorePatterns='/integration-tests/' --testPathPatterns=src",
    "test:integration": "../../../node_modules/.bin/jest --passWithNoTests --silent --bail --forceExit --testPathPatterns=\"src/.*/integration-tests/__tests__/.*\\.spec\\.ts\""
  }
}
