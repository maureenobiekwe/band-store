{
  "name": "docs-root",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "build:docs": "turbo run build --filter=book",
    "build:resources": "turbo run build --filter=resources",
    "build:user-guide": "turbo run build --filter=user-guide",
    "build:packages": "turbo run build --filter='./packages/*'",
    "start": "turbo run start:monorepo",
    "dev": "turbo run dev:monorepo",
    "lint": "turbo run lint",
    "lint:content": "turbo run lint:content",
    "watch": "turbo run watch",
    "prep": "turbo run prep",
    "test": "turbo run test -- run",
    "up:Band Store": "yarn workspaces foreach -v --topological-dev --recursive exec yarn up @band-store/icons @band-store/ui @band-store/ui-preset --exact"
  },
  "dependencies": {
    "autoprefixer": "10.4.14",
    "eslint": "^9.13.0",
    "postcss": "^8.5.10",
    "prettier": "^3.3.3",
    "tailwindcss": "3.3.3",
    "tsconfig": "*",
    "turbo": "^2.11.10"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.9",
    "@band-store/eslint-plugin": "link:../packages/eslint-plugin",
    "@eslint/js": "9.13.0",
    "@next/eslint-plugin-next": "16.4.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/eslint__js": "8.42.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-turbo": "2.2.3",
    "eslint-plugin-markdown": "5.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.37.2",
    "jsdom": "^25.0.1",
    "typescript-eslint": "^8.72.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "resolutions": {
    "@node-minify/core/glob": "^10.5.0",
    "instantsearch.js/qs": "^6.14.2",
    "@band-store/icons": "link:../packages/design-system/icons",
    "@band-store/ui": "link:../packages/design-system/ui",
    "@band-store/ui-preset": "link:../packages/design-system/ui-preset"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=20.9.0"
  }
}
